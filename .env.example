LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# PUBLIC_BASE_URL: cloudflared/host URL used in PDF links sent to LINE
PUBLIC_BASE_URL=https://memboy.ohmpire.dev   # permanent hostname via the cloudflared service
WEB_PASSWORD=
MCP_TOKEN=            # bearer token for the remote MCP endpoint /mcp (empty = disabled)
TUNNEL_TOKEN=          # Cloudflare tunnel token (dashboard → Tunnels → ohmpire); runs cloudflared in compose
ADMIN_LINE_USER_ID=       # LINE userId that gets tunnel alerts (push)
# LLM: any OpenAI-standard Chat Completions server. Default = Ollama on the host (ollama pull gemma4:12b)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma4:12b
LLM_FALLBACK=          # comma list of other models on the same server, tried when the main one fails
LLM_API_KEY=           # empty for Ollama
LLM_KEEP_ALIVE=24h     # Ollama-only: keep weights in VRAM; set empty for providers that reject unknown fields
LLM_REASONING_EFFORT=none   # gemma4 thinks by default (~40 s/call); none = answer directly
LLM_TIMEOUT_S=300
LLM_MAX_TOKENS=2048    # cap one reply; a runaway generation otherwise holds the GPU
PSEUDONYM_KEY=          # HMAC key for turn-log pseudonyms (app/privacy.py) — set once, never rotate
